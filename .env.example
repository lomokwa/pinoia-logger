# Copy to .env and set a real password before deploying.
# Grafana forces a password reset on first login regardless, so this is
# really just "don't leave the container reachable with the literal
# default admin/admin password even briefly."
GRAFANA_ADMIN_PASSWORD=changeme

# The public hostname you point at Grafana in Cloudflare Zero Trust
# (Networks > Tunnels > this tunnel > Public Hostname), e.g. https://logs.lomokwa.com.
# Used by Grafana to generate correct absolute links/redirects.
GRAFANA_ROOT_URL=https://logs.lomokwa.com

# Cloudflare Tunnel token — Zero Trust dashboard > Networks > Tunnels >
# Create a tunnel > Docker > copy the token from the `--token` flag shown
# there (do NOT commit the real value; this lives in .env, which is gitignored).
CLOUDFLARE_TUNNEL_TOKEN=

# Docker's actual data directory on THIS host — only needed if it's not the
# default /var/lib/docker (e.g. snap-installed Docker on Ubuntu uses
# /var/snap/docker/common/var-lib-docker). Check with:
#   docker info --format '{{.DockerRootDir}}'
DOCKER_DATA_ROOT=/var/lib/docker
